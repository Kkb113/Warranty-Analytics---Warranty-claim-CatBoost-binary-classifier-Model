# Optional local overrides. Copy to .env for development; never commit .env.
WARRANTY_MODEL_ENV=development
WARRANTY_MODEL_PROJECT_NAME=Truck-Warranty High-Cost Claim Prediction
WARRANTY_MODEL_RANDOM_SEED=42
WARRANTY_MODEL_LOG_LEVEL=INFO
WARRANTY_MODEL_DATA_DIR=data
WARRANTY_MODEL_ARTIFACT_DIR=artifacts
WARRANTY_MODEL_REPORT_DIR=reports
WARRANTY_MODEL_LOG_DIR=logs

# Optional live SQL Server settings. Keep credentials local and uncommitted.
WARRANTY_DB_SERVER=
WARRANTY_DB_PORT=1433
WARRANTY_DB_DATABASE=warranty_analytics
WARRANTY_DB_AUTH_MODE=trusted
WARRANTY_DB_USERNAME=
WARRANTY_DB_PASSWORD=
WARRANTY_DB_DRIVER=ODBC Driver 18 for SQL Server
WARRANTY_DB_ENCRYPT=true
WARRANTY_DB_TRUST_SERVER_CERTIFICATE=false
WARRANTY_DB_APPLICATION_INTENT=ReadOnly
WARRANTY_DB_CONNECTION_TIMEOUT_SECONDS=15
WARRANTY_DB_QUERY_TIMEOUT_SECONDS=30
WARRANTY_DB_APPLICATION_NAME=warranty_analytics_model
WARRANTY_RUN_DB_TESTS=false
